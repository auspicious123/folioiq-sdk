# FolioIQ — copy to .env and fill in

# Azure OpenAI (required for extract() without a custom llm=)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# Azure OpenAI deployment name (Portal → Deployments)
model=
# also accepted: AZURE_OPENAI_DEPLOYMENT

# Azure Document Intelligence (scans / images)
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
